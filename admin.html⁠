<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - PAMA</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-4 font-sans">
  <div class="max-w-4xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-2xl font-bold mb-4">รายการออเดอร์ทั้งหมด</h1>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-200">
            <th class="p-2 border">เวลา</th>
            <th class="p-2 border">ชื่อ</th>
            <th class="p-2 border">เบอร์โทร</th>
            <th class="p-2 border">ที่อยู่</th>
            <th class="p-2 border">สี</th>
            <th class="p-2 border">ไซส์</th>
            <th class="p-2 border">ราคา</th>
          </tr>
        </thead>
        <tbody id="orderTable">
          <tr><td colspan="7" class="p-4 text-center">กำลังโหลดข้อมูล...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const scriptURL = "https://script.google.com/macros/s/AKfycbxbTF1T3wyfmXBRzcbyVQYvt3MmQCyyNKkNnlep88fDGoDQt2m1qfJOn9IOWIdalMy7/exec";

    fetch(scriptURL)
      .then(res => res.json())
      .then(data => {
        const tbody = document.getElementById('orderTable');
        if(!data || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="p-4 text-center">ยังไม่มีออเดอร์</td></tr>';
          return;
        }
        tbody.innerHTML = data.map(item => `
          <tr class="border-b">
            <td class="p-2 border">${item.timestamp || ''}</td>
            <td class="p-2 border">${item.name || ''}</td>
            <td class="p-2 border">${item.phone || ''}</td>
            <td class="p-2 border">${item.address || ''}</td>
            <td class="p-2 border">${item.color || ''}</td>
            <td class="p-2 border">${item.size || ''}</td>
            <td class="p-2 border">${item.price || ''}</td>
          </tr>
        `).join('');
      })
      .catch(err => {
        document.getElementById('orderTable').innerHTML = '<tr><td colspan="7" class="p-4 text-center text-red-500">โหลดข้อมูลล้มเหลว</td></tr>';
      });
  </script>
</body>
</html>
