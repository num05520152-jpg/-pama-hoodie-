<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - PAMA</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen p-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">รายการสั่งซื้อสินค้า (Admin Dashboard)</h1>
      <button onclick="loadOrders()" class="bg-yellow-500 hover:bg-yellow-400 text-black font-semibold px-4 py-2 rounded-lg">รีเฟรชข้อมูล</button>
    </div>

    <div class="overflow-x-auto bg-gray-800 rounded-xl shadow-lg">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-700 text-gray-300">
          <tr>
            <th class="p-4">วัน/เวลา</th>
            <th class="p-4">ชื่อ-นามสกุล</th>
            <th class="p-4">เบอร์โทร</th>
            <th class="p-4">ที่อยู่</th>
            <th class="p-4">สี</th>
            <th class="p-4">ไซส์</th>
            <th class="p-4">จำนวน</th>
            <th class="p-4">ยอดเงิน</th>
          </tr>
        </thead>
        <tbody id="orderTable" class="divide-y divide-gray-700">
          <tr>
            <td colspan="8" class="p-4 text-center text-gray-400">กำลังโหลดข้อมูล...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const scriptURL = "https://script.google.com/macros/s/AKfycbx51kd1Af3dqTfcwMGK9c_h8QIFdMwv9A-rXKGFYwiJC2dEzj2R0EgYo7c8xMEBB5Q3/exec"; 

    function loadOrders() {
      fetch(scriptURL)
        .then(res => res.json())
        .then(data => {
          const tbody = document.getElementById('orderTable');
          tbody.innerHTML = '';
          if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-gray-400">ยังไม่มีรายการสั่งซื้อ</td></tr>';
            return;
          }
          data.forEach(order => {
            tbody.innerHTML += `
              <tr class="hover:bg-gray-750">
                <td class="p-4">${order.timestamp}</td>
                <td class="p-4">${order.name}</td>
                <td class="p-4">${order.phone}</td>
                <td class="p-4">${order.address}</td>
                <td class="p-4">${order.color}</td>
                <td class="p-4">${order.size}</td>
                <td class="p-4">${order.quantity}</td>
                <td class="p-4 text-yellow-400 font-bold">${order.totalPrice} บาท</td>
              </tr>
            `;
          });
        });
    }

    window.onload = loadOrders;
  </script>
</body>
</html>
